# Copy to .env and fill in. Never commit .env.
# Every variable below is optional: the defaults in config.py give a safe
# dry-run on bundled sample data with the mock LLM and no network calls
# to LLM providers or Telegram.
#
# Values shown here equal the defaults in config.py (two tests assert that
# AUTO_EDITORIAL_FLOOR and PREFILTER_MIN_SCORE match).

# --- Mode -------------------------------------------------------------------
# dry-run: posts are written as markdown drafts to data/drafts/, nothing is
# sent to the channel. live: posts are sent to TELEGRAM_CHANNEL_ID.
PUBLISH_MODE=dry-run

# legacy: the pipeline prepares candidate posts itself, a human approves them.
# digest: the pipeline stops after scoring and stores a short list of the day;
#         the expensive rewrite runs only for the story a human picks.
# auto:   like digest, but a scheduler picks the best story for each slot.
WORKFLOW_MODE=legacy

# --- LLM --------------------------------------------------------------------
# mock (default, no keys, no network) | gemini | openai | anthropic
LLM_PROVIDER=mock

GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL_CHEAP=gemini-flash-lite-latest
GEMINI_MODEL_MID=gemini-flash-latest

OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL_CHEAP=gpt-5.4-nano
OPENAI_MODEL_MID=gpt-5.4-mini

ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5

# Requests per minute to the cheap model. 0 disables the limiter.
LLM_RPM_LIMIT=14

# Model names and prices change often: check config.LLM_PRICES_PER_1M before
# a real run. A model missing from that table is priced at the most expensive
# known rate, so the budget guard never silently turns off.

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your-bot-token-here
# Numeric Telegram user id of the owner (the bot sends candidates here).
TELEGRAM_OWNER_CHAT_ID=your-numeric-telegram-user-id
# Channel to publish to when PUBLISH_MODE=live: @your_channel or -100...
# There is deliberately no default: an empty value stops live publishing.
TELEGRAM_CHANNEL_ID=@your_channel
# Extra editors, comma-separated numeric ids (the owner is added automatically).
TELEGRAM_ADMIN_IDS=
# Display names for the admins screen: "111111111=Alice, 222222222=Bob".
TELEGRAM_ADMIN_LABELS=

# --- Sources ----------------------------------------------------------------
GDELT_ENABLED=false
NEWSDATA_API_KEY=
# false returns to the three general-purpose feeds only.
DISCOVERY_ENABLED=true
# Comma-separated source names from src/sources.py, e.g. SOURCES_DISABLED=Europol,NCA
SOURCES_DISABLED=
SOURCES_ENABLED=
FEED_TIMEOUT_SEC=20
FEED_RETRIES=1

# --- Selection and quality thresholds ---------------------------------------
MIN_RELEVANCE_SUM=0
MIN_EDITORIAL_AVG=8.6
EDITORIAL_BORDERLINE_MIN=8.0
# Floor of the automatic editor. config.py clamps values below 8.0 up to 8.0.
AUTO_EDITORIAL_FLOOR=8.0
MAX_TOPICS_PER_RUN=2
MAX_CANDIDATES_PER_DAY=3
MAX_REGENERATE_ATTEMPTS=2
MAX_PENDING_QUEUE=10
DEDUPE_L1_THRESHOLD=0.75
STORY_MAX_AGE_HOURS=24

# Cheap pre-filter before the paid relevance stage.
PREFILTER_MIN_SCORE=-9
PREFILTER_SOURCE_QUOTA=0.4
MAX_LLM_ITEMS_PER_RUN=40

# --- Cost caps (USD) --------------------------------------------------------
MAX_RUN_COST_USD=0.05
DAILY_COST_LIMIT_USD=0.10
MONTHLY_COST_TARGET_USD=3.0
MONTHLY_COST_LIMIT_USD=5.0

# --- Digest / manual selection ----------------------------------------------
DIGEST_SIZE=10
MAX_SUCCESSFUL_SELECTIONS_PER_DAY=2
MAX_PREPARATION_ATTEMPTS_PER_DAY=4
DIGEST_TTL_HOURS=24

# --- Schedule (local time of SCHEDULE_TZ; stored as UTC in the database) ----
SCHEDULE_TZ=Europe/Moscow
MORNING_SLOT=09:00
DAY_SLOT=14:00
EVENING_SLOT=20:00
SCHEDULE_GRACE_MINUTES=120

# --- Automatic editor (WORKFLOW_MODE=auto) ----------------------------------
AUTO_MAX_POSTS_PER_DAY=3
AUTO_LEAD_MINUTES=25
AUTO_FRESHNESS_HOURS=24

# --- Threads mirror (optional) ----------------------------------------------
THREADS_ENABLED=false
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_TEXT_LIMIT=500
THREADS_MAX_ATTEMPTS=6
THREADS_REFRESH_BEFORE_DAYS=15

LOG_LEVEL=INFO
